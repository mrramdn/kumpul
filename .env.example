# Salin file ini menjadi .env, lalu ganti nilainya:
#   cp .env.example .env
# .env tidak ikut di-commit (lihat .gitignore). Jangan taruh password asli di file ini.

# Database PostgreSQL. Dipakai service db untuk membuat database, dan service web untuk terhubung.
POSTGRES_DB=kumpul
POSTGRES_USER=kumpul
POSTGRES_PASSWORD=ganti-dengan-password-lokal

# Password penyelenggara: dibutuhkan untuk membuat, mengubah, dan menghapus acara.
# Mendaftar ke acara tidak butuh password. Kosongkan untuk mode terbuka (semua orang bisa mengelola).
ORGANIZER_PASSWORD=ganti-password-penyelenggara

# Aplikasi dibuka di http://localhost:WEB_PORT
WEB_PORT=3000
# 127.0.0.1 = hanya bisa dibuka dari laptop ini. 0.0.0.0 = bisa dibuka perangkat lain di jaringan yang sama.
WEB_BIND=127.0.0.1

# Port Adminer, hanya jalan dengan --profile debug.
ADMINER_PORT=8081

# Label lingkungan yang ditampilkan di /api/health.
APP_ENV=local
